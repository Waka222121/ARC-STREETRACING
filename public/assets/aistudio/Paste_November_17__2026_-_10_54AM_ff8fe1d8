// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import {Test, console2} from "forge-std/Test.sol";
import {RandomnessHub} from "../RandomnessHub.sol";
import {IRandomnessHub} from "../IRandomnessHub.sol";
import {EvmnetVectors as V} from "./EvmnetVectors.sol";
import {MockConsumer, MockRelayer} from "../test-helpers/HubMocks.sol";

/// @dev Shared fixture. PUBLIC KEY ORDERING FOUND EMPIRICALLY:
/// drand published words (w0,w1,w2,w3) must be passed to the hub as [w1, w0, w3, w2]
/// (i.e. swap the two words of each G2 coordinate). The published order and the other
/// swaps are rejected by BLS.isValidPublicKey.
abstract contract RandomnessHubTestBase is Test {
    uint256 internal constant BN254_P =
        21888242871839275222246405745257275088696311157297823662689037894645226208583;
    uint256 internal constant REWARD = 1e16;
    uint32 internal constant CB_GAS = 100_000;

    RandomnessHub internal hub;
    address internal relayer = makeAddr("relayer");
    address internal alice = makeAddr("alice");
    address internal bob = makeAddr("bob");

    function _pk() internal pure returns (uint256[4] memory) {
        return [V.PK_WORD_1, V.PK_WORD_0, V.PK_WORD_3, V.PK_WORD_2];
    }

    function setUp() public virtual {
        vm.warp(V.GENESIS_TIME + 1 days);
        hub = new RandomnessHub(_pk(), V.GENESIS_TIME, V.PERIOD);
    }

    /// @dev Time of vector i's round.
    function _rt(uint256 i) internal pure returns (uint256) {
        return V.GENESIS_TIME + uint256(V.round(i)) * V.PERIOD;
    }

    /// @dev Warp so a request made now targets exactly vector i's round.
    function _warpToRequest(uint256 i) internal {
        vm.warp(_rt(i) - 3 * V.PERIOD);
    }

    function _newConsumer() internal returns (MockConsumer) {
        return new MockConsumer(address(hub));
    }

    function _req(MockConsumer c, uint32 gas_, uint256 reward) internal returns (uint256 id) {
        // The test contract funds the request (msg.value is forwarded by the consumer).
        id = c.request{value: reward}(gas_);
    }

    function _status(uint256 id) internal view returns (IRandomnessHub.Status) {
        return hub.getRequest(id).status;
    }

    function _fulfill(address who, uint256 id, uint256 vec) internal {
        vm.prank(who);
        hub.fulfill(id, V.signature(vec));
    }

    function _invalidSig() internal pure returns (uint256[2] memory) {
        return [uint256(1), uint256(1)];
    }
}
