// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import {RandomnessConsumer} from "./RandomnessConsumer.sol";

/// @title RandomnessDemo
/// @notice Tiny example consumer used to test RandomnessHub on a live network.
/// @dev Demo only. It holds no funds and has no owner. It follows the three consumer rules:
/// (1) freeze every input that affects the outcome before requesting (this demo has none),
/// (2) never revert in the callback (it only stores the value),
/// (3) keep your own timeout, because a round can be delayed (a real app should add one).
contract RandomnessDemo is RandomnessConsumer {
    uint32 public constant CALLBACK_GAS = 100_000;

    mapping(uint256 => bytes32) public results;
    mapping(uint256 => address) public requesters;
    uint256 public lastRequestId;

    event Rolled(uint256 indexed id, address indexed requester);
    event Settled(uint256 indexed id, bytes32 randomness);

    constructor(address hub) RandomnessConsumer(hub) {}

    /// @notice Ask the hub for a random number. `msg.value` is the relayer reward in native USDC
    /// (18-decimal units on Arc).
    function roll() external payable returns (uint256 id) {
        id = _requestRandomness(CALLBACK_GAS, msg.value);
        requesters[id] = msg.sender;
        lastRequestId = id;
        emit Rolled(id, msg.sender);
    }

    /// @notice Whether a request has been answered, and the value if so.
    function resultOf(uint256 id) external view returns (bool ready, bytes32 randomness) {
        randomness = results[id];
        ready = randomness != bytes32(0);
    }

    function _onRandomness(uint256 id, bytes32 randomness) internal override {
        results[id] = randomness;
        emit Settled(id, randomness);
    }
}
