// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import {BLS} from "@kevincharm/bls-bn254/contracts/BLS.sol";
import {IRandomnessHub} from "./IRandomnessHub.sol";

/// @title RandomnessHub
/// @notice Ownerless, immutable drand evmnet registry and callback hub for Arc.
/// @dev Uses bls-bn254-unchained-on-g1; evmnet deployment parameters have a three-second period.
/// Rewards and credits are native USDC in 18-decimal units, not the ERC-20's six-decimal view.
/// CONSUMER RULES:
/// (1) Freeze every input affecting the outcome BEFORE calling requestRandomness: a round's
/// value becomes public on drand before it lands onchain.
/// (2) Never revert in the callback: record the value and settle in a separate transaction.
/// (3) Keep your own timeout and refund path because a round can be delayed.
/// This contract is immutable by design, with no owner, admin, pause, upgrade or protocol fee.
/// It needs an independent audit before mainnet because the BLS library is unaudited.
contract RandomnessHub is IRandomnessHub, ReentrancyGuard {
    uint256 public constant MIN_DELAY_PERIODS = 3;
    uint256 public constant EXPIRY = 1 days;
    /// @dev 0.01 USDC in 18-decimal native units. A fulfillment costs about 0.005 USDC in gas on Arc
    /// (measured about 258,000 gas), so a smaller floor would make relaying a losing trade.
    uint256 public constant MIN_REWARD = 1e16;
    uint256 public constant MAX_CALLBACK_GAS = 500_000;
    uint256 public constant CALLBACK_OVERHEAD = 30_000;
    uint256 private constant PAYOUT_GAS = 50_000;
    bytes private constant DST = "BLS_SIG_BN254G1_XMD:KECCAK-256_SVDW_RO_NUL_";
    bytes4 private constant CALLBACK_SELECTOR = bytes4(keccak256("onRandomness(uint256,bytes32)"));

    uint256 private immutable PUBLIC_KEY_0;
    uint256 private immutable PUBLIC_KEY_1;
    uint256 private immutable PUBLIC_KEY_2;
    uint256 private immutable PUBLIC_KEY_3;
    uint256 public immutable override genesisTime;
    uint256 public immutable override period;

    mapping(uint64 => bytes32) public override beacon;
    mapping(uint256 => Request) private requests;
    mapping(address => uint256) public credits;
    uint256 public nextRequestId = 1;

    error InvalidPublicKey();
    error InvalidPeriod();
    error InvalidSignature();
    error RewardTooSmall();
    error RewardTooLarge();
    error CallbackGasTooHigh();
    error RoundOverflow();
    error InvalidStatus();
    error BeaconAlreadyStored();
    error BeaconUnavailable();
    error NotConsumer();
    error NotExpired();
    error InsufficientGas();
    error NoCredit();
    error TransferFailed();

    /// @notice A consumer funded a request tied to a future round.
    event Requested(uint256 indexed id, address indexed consumer, uint64 round, uint128 reward);
    /// @notice A verified round was permanently registered.
    event BeaconStored(uint64 indexed round, bytes32 value);
    /// @notice Delivery succeeded, including delivery to an address with no code.
    event Fulfilled(uint256 indexed id, address indexed fulfiller);
    /// @notice Delivery failed; anyone may retry without an additional reward.
    event CallbackFailed(uint256 indexed id);
    /// @notice An expired request was cancelled and its reward refunded or credited.
    event Cancelled(uint256 indexed id);
    /// @notice A failed native payout was added to the recipient's withdrawable credit.
    event PayoutCredited(address indexed account, uint256 amount);
    /// @notice A recipient withdrew native-USDC credit.
    event Claimed(address indexed account, uint256 amount);

    /// @notice Fix the drand key and schedule permanently; validates the key and a positive period.
    /// @param publicKey_ G2 key in BLS library order [x0, x1, y0, y1], passed unchanged to
    /// verifySingle. That library internally swaps each pair for the pairing precompile.
    /// @param genesisTime_ Genesis Unix timestamp in seconds.
    /// @param period_ Round period in seconds; use three for drand evmnet.
    constructor(uint256[4] memory publicKey_, uint256 genesisTime_, uint256 period_) {
        if (!BLS.isValidPublicKey(publicKey_)) revert InvalidPublicKey();
        if (period_ == 0) revert InvalidPeriod();
        PUBLIC_KEY_0 = publicKey_[0];
        PUBLIC_KEY_1 = publicKey_[1];
        PUBLIC_KEY_2 = publicKey_[2];
        PUBLIC_KEY_3 = publicKey_[3];
        genesisTime = genesisTime_;
        period = period_;
    }

    /// @inheritdoc IRandomnessHub
    function publicKey() public view override returns (uint256[4] memory key) {
        return [PUBLIC_KEY_0, PUBLIC_KEY_1, PUBLIC_KEY_2, PUBLIC_KEY_3];
    }

    /// @inheritdoc IRandomnessHub
    function roundAt(uint256 timestamp) public view override returns (uint256 round) {
        if (timestamp <= genesisTime) return 1;
        uint256 delta = timestamp - genesisTime;
        round = delta / period + (delta % period > 0 ? 1 : 0);
        if (round == 0) return 1;
    }

    /// @inheritdoc IRandomnessHub
    function roundTime(uint64 round) public view override returns (uint256 timestamp) {
        return genesisTime + uint256(round) * period;
    }

    /// @inheritdoc IRandomnessHub
    /// @dev Accepts even a zero callback gas cap; the requester bears delivery failure risk.
    /// Reverts rather than truncating an oversized reward or a round above uint64 capacity.
    function requestRandomness(uint32 callbackGas)
        external payable override nonReentrant returns (uint256 id)
    {
        if (msg.value < MIN_REWARD) revert RewardTooSmall();
        if (msg.value > type(uint128).max) revert RewardTooLarge();
        if (callbackGas > MAX_CALLBACK_GAS) revert CallbackGasTooHigh();
        uint256 round = roundAt(block.timestamp + MIN_DELAY_PERIODS * period);
        if (round > type(uint64).max) revert RoundOverflow();
        id = nextRequestId++;
        requests[id] = Request({
            consumer: msg.sender,
            round: uint64(round),
            callbackGas: callbackGas,
            reward: uint128(msg.value),
            status: Status.Pending
        });
        emit Requested(id, msg.sender, uint64(round), uint128(msg.value));
    }

    /// @inheritdoc IRandomnessHub
    /// @dev Marks the request before payout and callback. Insufficient callback gas reverts
    /// the entire transaction, including any beacon storage, payout and credit changes.
    function fulfill(uint256 id, uint256[2] calldata signature) external override nonReentrant {
        Request storage request = requests[id];
        if (request.status != Status.Pending) revert InvalidStatus();
        if (beacon[request.round] == bytes32(0)) _storeBeacon(request.round, signature);
        request.status = Status.Fulfilled;
        _payOrCredit(msg.sender, request.reward);
        _deliver(id, request);
    }

    /// @inheritdoc IRandomnessHub
    function submitBeacon(uint64 round, uint256[2] calldata signature) external override nonReentrant {
        if (beacon[round] != bytes32(0)) revert BeaconAlreadyStored();
        _storeBeacon(round, signature);
    }

    /// @inheritdoc IRandomnessHub
    /// @dev Sets Fulfilled before callback; a failed retry returns to CallbackFailed.
    /// The Fulfilled event identifies the successful retry caller, who receives no reward.
    function retryCallback(uint256 id) external override nonReentrant {
        Request storage request = requests[id];
        if (request.status != Status.CallbackFailed) revert InvalidStatus();
        request.status = Status.Fulfilled;
        _deliver(id, request);
    }

    /// @inheritdoc IRandomnessHub
    /// @dev Expiry is strictly later than roundTime(round) + EXPIRY. A stored beacon
    /// permanently disables cancellation, even if no relayer has fulfilled the request.
    function cancel(uint256 id) external override nonReentrant {
        Request storage request = requests[id];
        if (request.consumer != msg.sender) revert NotConsumer();
        if (request.status != Status.Pending) revert InvalidStatus();
        if (beacon[request.round] != bytes32(0)) revert BeaconAlreadyStored();
        if (block.timestamp <= roundTime(request.round) + EXPIRY) revert NotExpired();
        request.status = Status.Cancelled;
        _payOrCredit(request.consumer, request.reward);
        emit Cancelled(id);
    }

    /// @inheritdoc IRandomnessHub
    /// @dev Zeroes credit before the checked native call. Failure reverts and restores credit.
    function claim() external override nonReentrant {
        uint256 amount = credits[msg.sender];
        if (amount == 0) revert NoCredit();
        credits[msg.sender] = 0;
        (bool success, ) = payable(msg.sender).call{value: amount}("");
        if (!success) revert TransferFailed();
        emit Claimed(msg.sender, amount);
    }

    /// @inheritdoc IRandomnessHub
    function getRequest(uint256 id) external view override returns (Request memory request) {
        return requests[id];
    }

    /// @inheritdoc IRandomnessHub
    /// @dev Available as soon as the beacon is stored, regardless of callback status.
    function randomnessOf(uint256 id) public view override returns (bytes32 randomness) {
        Request storage request = requests[id];
        bytes32 value = beacon[request.round];
        if (request.status == Status.None || value == bytes32(0)) revert BeaconUnavailable();
        return keccak256(abi.encode(value, address(this), block.chainid, id));
    }

    /// @dev All curve operations are delegated to the installed BLS library, not reimplemented.
    function _storeBeacon(uint64 round, uint256[2] calldata signature) private {
        // Validate the G1 point before hashing or pairing, including for an invalid zero round.
        if (!BLS.isValidSignature(signature)) revert InvalidSignature();
        if (round == 0) revert InvalidSignature();
        uint256[2] memory message = BLS.hashToPoint(
            DST, abi.encodePacked(keccak256(abi.encodePacked(round)))
        );
        (bool pairingSuccess, bool callSuccess) = BLS.verifySingle(signature, publicKey(), message);
        if (!pairingSuccess || !callSuccess) revert InvalidSignature();
        bytes32 value = keccak256(abi.encode(signature));
        beacon[round] = value;
        emit BeaconStored(round, value);
    }

    /// @dev Check gas immediately before delivery; no callback return data is ever copied.
    function _deliver(uint256 id, Request storage request) private {
        address consumer = request.consumer;
        uint256 callbackGas = request.callbackGas;
        bytes memory payload = abi.encodeWithSelector(CALLBACK_SELECTOR, id, randomnessOf(id));
        bool success = true;
        bool hasCode = consumer.code.length != 0;
        if (gasleft() < callbackGas * 64 / 63 + CALLBACK_OVERHEAD) revert InsufficientGas();
        if (hasCode) {
            assembly ("memory-safe") {
                success := call(callbackGas, consumer, 0, add(payload, 32), mload(payload), 0, 0)
            }
        }
        if (success) {
            emit Fulfilled(id, msg.sender);
        } else {
            request.status = Status.CallbackFailed;
            emit CallbackFailed(id);
        }
    }

    /// @dev Native payouts have bounded gas and no return-data copying. On Arc a zero
    /// recipient cannot receive native USDC, so it is credited without attempting a call.
    function _payOrCredit(address recipient, uint256 amount) private {
        bool success;
        if (recipient != address(0)) {
            uint256 payoutGas = PAYOUT_GAS;
            assembly ("memory-safe") {
                success := call(payoutGas, recipient, amount, 0, 0, 0, 0)
            }
        }
        if (!success) {
            credits[recipient] += amount;
            emit PayoutCredited(recipient, amount);
        }
    }
}
