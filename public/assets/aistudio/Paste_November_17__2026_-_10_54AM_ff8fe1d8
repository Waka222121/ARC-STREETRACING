pragma solidity ^0.8.20;

import {RandomnessHubTestBase, RandomnessHub, IRandomnessHub, V, MockConsumer} from "./RandomnessHub.Base.t.sol";

contract RandomnessHubVectorsTest is RandomnessHubTestBase {
    // ---------------------------------------------------------------- (1) real signatures

    function test_PublicKeyStoredUnchanged() public view {
        uint256[4] memory k = hub.publicKey();
        uint256[4] memory e = _pk();
        for (uint256 i; i < 4; i++) assertEq(k[i], e[i]);
        assertEq(hub.genesisTime(), V.GENESIS_TIME);
        assertEq(hub.period(), V.PERIOD);
    }

    function test_SubmitBeacon_AllRealVectorsVerify() public {
        for (uint256 i; i < V.COUNT; i++) {
            uint64 r = V.round(i);
            assertEq(hub.beacon(r), bytes32(0));
            bytes32 expected = keccak256(abi.encode(V.signature(i)));
            vm.expectEmit(true, false, false, true, address(hub));
            emit RandomnessHub.BeaconStored(r, expected);
            hub.submitBeacon(r, V.signature(i));
            assertEq(hub.beacon(r), expected);
            assertTrue(expected != bytes32(0));
        }
    }

    function test_SubmitBeacon_RevertsIfAlreadyStored() public {
        hub.submitBeacon(V.round(0), V.signature(0));
        vm.expectRevert(RandomnessHub.BeaconAlreadyStored.selector);
        hub.submitBeacon(V.round(0), V.signature(0));
    }

    function test_Fulfill_AllRealVectorsVerifyAndDeliver() public {
        for (uint256 i; i < V.COUNT; i++) {
            _warpToRequest(i);
            MockConsumer c = _newConsumer();
            uint256 id = _req(c, CB_GAS, REWARD);
            assertEq(uint256(hub.getRequest(id).round), uint256(V.round(i)));
            uint256 before = relayer.balance;
            _fulfill(relayer, id, i);
            assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.Fulfilled), "status");
            assertEq(relayer.balance, before + REWARD, "reward");
            assertEq(hub.beacon(V.round(i)), keccak256(abi.encode(V.signature(i))));
            assertEq(c.got(id), hub.randomnessOf(id), "callback value");
            assertEq(c.callbacks(), 1);
        }
        assertEq(address(hub).balance, 0);
    }

    function test_Submit_TamperedBitFlipReverts() public {
        for (uint256 i; i < V.COUNT; i++) {
            uint256[2] memory s = V.signature(i);
            s[0] ^= 1;
            vm.expectRevert(RandomnessHub.InvalidSignature.selector);
            hub.submitBeacon(V.round(i), s);
            s = V.signature(i);
            s[1] ^= (1 << 100);
            vm.expectRevert(RandomnessHub.InvalidSignature.selector);
            hub.submitBeacon(V.round(i), s);
            assertEq(hub.beacon(V.round(i)), bytes32(0));
        }
    }

    function test_Submit_NegatedSignatureReverts() public {
        // (x, p - y) is a valid curve point but not the signature.
        uint256[2] memory s = V.signature(3);
        s[1] = BN254_P - s[1];
        vm.expectRevert(RandomnessHub.InvalidSignature.selector);
        hub.submitBeacon(V.round(3), s);
    }

    function test_Submit_OtherRoundsSignatureReverts() public {
        for (uint256 i; i < V.COUNT; i++) {
            uint256 j = (i + 1) % V.COUNT;
            vm.expectRevert(RandomnessHub.InvalidSignature.selector);
            hub.submitBeacon(V.round(i), V.signature(j));
        }
        // Adjacent consecutive rounds 22162834..36.
        vm.expectRevert(RandomnessHub.InvalidSignature.selector);
        hub.submitBeacon(V.round(15), V.signature(16));
    }

    function test_Submit_WrongRoundNumberReverts() public {
        vm.expectRevert(RandomnessHub.InvalidSignature.selector);
        hub.submitBeacon(V.round(0) + 1, V.signature(0));
        vm.expectRevert(RandomnessHub.InvalidSignature.selector);
        hub.submitBeacon(V.round(0) - 1, V.signature(0));
    }

    function test_Submit_RoundZeroReverts() public {
        vm.expectRevert(RandomnessHub.InvalidSignature.selector);
        hub.submitBeacon(0, V.signature(0));
    }

    function test_Submit_InvalidG1PointReverts() public {
        vm.expectRevert(RandomnessHub.InvalidSignature.selector);
        hub.submitBeacon(V.round(0), [uint256(1), uint256(1)]); // off-curve
        vm.expectRevert(RandomnessHub.InvalidSignature.selector);
        hub.submitBeacon(V.round(0), [BN254_P, uint256(1)]); // coordinate >= p
        vm.expectRevert(RandomnessHub.InvalidSignature.selector);
        hub.submitBeacon(V.round(0), [V.signature(0)[0], BN254_P]); // y >= p
        vm.expectRevert(RandomnessHub.InvalidSignature.selector);
        hub.submitBeacon(V.round(0), [type(uint256).max, type(uint256).max]);
        vm.expectRevert(RandomnessHub.InvalidSignature.selector);
        hub.submitBeacon(V.round(0), [uint256(0), uint256(0)]); // point at infinity
    }

    function test_Fulfill_BadSignatureRevertsWithoutStateChange() public {
        _warpToRequest(0);
        MockConsumer c = _newConsumer();
        uint256 id = _req(c, CB_GAS, REWARD);
        uint256[2] memory s = V.signature(1); // another round's signature
        vm.prank(relayer);
        vm.expectRevert(RandomnessHub.InvalidSignature.selector);
        hub.fulfill(id, s);
        vm.prank(relayer);
        vm.expectRevert(RandomnessHub.InvalidSignature.selector);
        hub.fulfill(id, _invalidSig());
        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.Pending));
        assertEq(relayer.balance, 0);
        assertEq(address(hub).balance, REWARD);
        assertEq(hub.beacon(V.round(0)), bytes32(0));
    }

    // ---------------------------------------------------------------- (2) constructor

    function test_Constructor_RejectsInvalidKey() public {
        vm.expectRevert(RandomnessHub.InvalidPublicKey.selector);
        new RandomnessHub([uint256(0), 0, 0, 0], V.GENESIS_TIME, V.PERIOD);
        vm.expectRevert(RandomnessHub.InvalidPublicKey.selector);
        new RandomnessHub([uint256(1), 2, 3, 4], V.GENESIS_TIME, V.PERIOD);
        // Published (unswapped) word order is not a valid key for the library.
        vm.expectRevert(RandomnessHub.InvalidPublicKey.selector);
        new RandomnessHub([V.PK_WORD_0, V.PK_WORD_1, V.PK_WORD_2, V.PK_WORD_3], V.GENESIS_TIME, V.PERIOD);
        vm.expectRevert(RandomnessHub.InvalidPublicKey.selector);
        new RandomnessHub([V.PK_WORD_1, V.PK_WORD_0, V.PK_WORD_2, V.PK_WORD_3], V.GENESIS_TIME, V.PERIOD);
        vm.expectRevert(RandomnessHub.InvalidPublicKey.selector);
        new RandomnessHub([V.PK_WORD_0, V.PK_WORD_1, V.PK_WORD_3, V.PK_WORD_2], V.GENESIS_TIME, V.PERIOD);
    }

    function test_Constructor_RejectsZeroPeriod() public {
        vm.expectRevert(RandomnessHub.InvalidPeriod.selector);
        new RandomnessHub(_pk(), V.GENESIS_TIME, 0);
    }

    function test_Constructor_StoresParams() public {
        RandomnessHub h = new RandomnessHub(_pk(), 1234, 7);
        assertEq(h.genesisTime(), 1234);
        assertEq(h.period(), 7);
        assertEq(h.nextRequestId(), 1);
    }

    // ---------------------------------------------------------------- (3) rounds

    function test_RoundAt_Boundaries() public view {
        uint256 g = V.GENESIS_TIME;
        assertEq(hub.roundAt(0), 1);
        assertEq(hub.roundAt(g - 1), 1);
        assertEq(hub.roundAt(g), 1);
        assertEq(hub.roundAt(g + 1), 1);
        assertEq(hub.roundAt(g + 3), 1);
        assertEq(hub.roundAt(g + 4), 2);
        assertEq(hub.roundAt(g + 6), 2);
        assertEq(hub.roundAt(g + 7), 3);
        assertEq(hub.roundAt(g + 3000), 1000);
        assertEq(hub.roundAt(g + 3001), 1001);
        assertEq(hub.roundTime(1), g + 3);
        assertEq(hub.roundTime(1000), g + 3000);
        assertEq(hub.roundTime(0), g);
    }

    function testFuzz_RoundAtIsFirstRoundAtOrAfter(uint256 ts) public view {
        ts = bound(ts, V.GENESIS_TIME + 1, 1 << 60);
        uint256 r = hub.roundAt(ts);
        assertGe(hub.roundTime(uint64(r)), ts);
        assertLt(hub.roundTime(uint64(r)), ts + V.PERIOD);
    }

    function testFuzz_RoundAtMonotonic(uint256 a, uint256 b) public view {
        a = bound(a, 0, 1 << 100);
        b = bound(b, a, 1 << 100);
        assertLe(hub.roundAt(a), hub.roundAt(b));
    }

    function testFuzz_RequestRoundAtLeastThreePeriodsAhead(uint256 ts) public {
        ts = bound(ts, 0, 1 << 60);
        vm.warp(ts);
        MockConsumer c = _newConsumer();
        uint256 id = _req(c, 0, REWARD);
        uint64 r = hub.getRequest(id).round;
        assertGe(r, 1);
        // Actual guarantee: the target round is scheduled at least 3 periods after the request.
        assertGe(hub.roundTime(r), ts + 3 * V.PERIOD);
        // ...and at most 3 periods + (period - 1) seconds of ceiling slack, unless clamped to round 1.
        if (ts + 3 * V.PERIOD > V.GENESIS_TIME) {
            assertLt(hub.roundTime(r), ts + 3 * V.PERIOD + V.PERIOD);
        } else {
            assertEq(r, 1);
        }
    }

    function testFuzz_LaterRequestNeverGetsEarlierRound(uint256 a, uint256 d) public {
        a = bound(a, 0, 1 << 60);
        d = bound(d, 0, 1 << 40);
        MockConsumer c = _newConsumer();
        vm.warp(a);
        uint64 r1 = hub.getRequest(_req(c, 0, REWARD)).round;
        vm.warp(a + d);
        uint64 r2 = hub.getRequest(_req(c, 0, REWARD)).round;
        assertGe(r2, r1);
    }
}
