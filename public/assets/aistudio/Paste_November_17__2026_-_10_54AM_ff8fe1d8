/**
 * RandomnessHub relayer.
 *
 * Watches the hub for pending randomness requests, downloads the matching drand evmnet
 * round signature, and submits `fulfill` to earn the request reward. Anyone can run this;
 * the contract verifies every signature itself, so the relayer needs no trust.
 *
 * Usage:
 *   bun run relayer                 run forever
 *   bun run relayer -- --once       one pass, then exit
 *   bun run relayer -- --dry-run    simulate only, never send
 *
 * Environment (set in .env, never commit values):
 *   VITE_RANDOMNESS_HUB_ADDRESS   deployed hub address (public)
 *   RELAYER_PRIVATE_KEY           key of a dedicated relayer wallet (needs a little gas)
 *   RELAYER_LOOKBACK              optional, how many recent request ids to scan on start (default 300)
 *   RELAYER_MIN_REWARD_WEI        optional, skip requests paying less than this (native, 18 decimals)
 */
import { createPublicClient, createWalletClient, http, parseAbi, type Address, type Hex } from 'viem'
import { privateKeyToAccount } from 'viem/accounts'
import { arcTestnet } from 'viem/chains'
import { requireChain } from '../src/onchain-facts'
import { Amount, gasTokenDecimalsFor } from '../src/onchain-money'

const CHAIN_ID = arcTestnet.id
const CHAIN_HASH = '04f1e9062b8a81f848fded9c12306733282b2727ecced50032187751166ec8c3'
const DRAND_SOURCES = [
  'https://api.drand.sh/v2/beacons/evmnet/rounds',
  `https://drand.cloudflare.com/${CHAIN_HASH}/public`,
]
const POLL_MS = 3000

const hubAbi = parseAbi([
  'struct Request { address consumer; uint64 round; uint32 callbackGas; uint128 reward; uint8 status; }',
  'function nextRequestId() view returns (uint256)',
  'function getRequest(uint256 id) view returns (Request)',
  'function beacon(uint64 round) view returns (bytes32)',
  'function fulfill(uint256 id, uint256[2] signature)',
])

const STATUS_PENDING = 1

const args = new Set(process.argv.slice(2))
const once = args.has('--once')
const dryRun = args.has('--dry-run')

function resolveRpcUrl(): string {
  // The relayer sends transactions, and the Arc Studio RPC proxy does not accept them,
  // so use your own endpoint if set, otherwise the public one.
  const configured = process.env.RPC_URL_Arc_Testnet
  if (configured) return configured
  console.warn('Using public RPC: it may rate-limit under load. Set RPC_URL_Arc_Testnet for your own provider.')
  return requireChain(CHAIN_ID).rpcUrls[0]
}

function readEnv() {
  const hub = process.env.VITE_RANDOMNESS_HUB_ADDRESS as Address | undefined
  if (!hub) throw new Error('VITE_RANDOMNESS_HUB_ADDRESS is not set. Deploy the hub first.')
  const key = process.env.RELAYER_PRIVATE_KEY as Hex | undefined
  if (!key && !dryRun) throw new Error('RELAYER_PRIVATE_KEY is not set. Add it to .env, or run with --dry-run.')
  return {
    hub,
    key,
    lookback: BigInt(process.env.RELAYER_LOOKBACK ?? '300'),
    minReward: BigInt(process.env.RELAYER_MIN_REWARD_WEI ?? '0'),
  }
}

async function fetchSignature(round: bigint): Promise<[bigint, bigint] | null> {
  for (const base of DRAND_SOURCES) {
    try {
      const res = await fetch(`${base}/${round}`, { signal: AbortSignal.timeout(8000) })
      if (!res.ok) continue
      const body = (await res.json()) as { signature?: string }
      const sig = body.signature
      if (!sig || !/^[0-9a-fA-F]{128}$/.test(sig)) continue
      return [BigInt(`0x${sig.slice(0, 64)}`), BigInt(`0x${sig.slice(64)}`)]
    } catch {
      // try the next source
    }
  }
  return null
}

async function main() {
  const env = readEnv()
  const transport = http(resolveRpcUrl())
  const publicClient = createPublicClient({ chain: arcTestnet, transport })
  const account = env.key ? privateKeyToAccount(env.key) : undefined
  const walletClient = account ? createWalletClient({ account, chain: arcTestnet, transport }) : undefined
  const decimals = gasTokenDecimalsFor(CHAIN_ID)
  console.log(`Relayer for hub ${env.hub}${account ? ` as ${account.address}` : ' (dry run)'}`)

  const known = new Set<bigint>()
  const inflight = new Set<bigint>()
  let scanned = 0n
  let running = true
  process.on('SIGINT', () => {
    running = false
  })

  const tick = async () => {
    const next = await publicClient.readContract({ address: env.hub, abi: hubAbi, functionName: 'nextRequestId' })
    if (scanned === 0n) scanned = next > env.lookback ? next - env.lookback : 0n
    for (let id = scanned + 1n; id < next; id++) known.add(id)
    scanned = next - 1n

    for (const id of [...known]) {
      if (inflight.has(id)) continue
      const request = await publicClient.readContract({ address: env.hub, abi: hubAbi, functionName: 'getRequest', args: [id] })
      if (request.status !== STATUS_PENDING) {
        known.delete(id)
        continue
      }
      if (BigInt(request.reward) < env.minReward) continue

      const stored = await publicClient.readContract({ address: env.hub, abi: hubAbi, functionName: 'beacon', args: [request.round] })
      const signature: [bigint, bigint] | null =
        stored !== `0x${'00'.repeat(32)}` ? [0n, 0n] : await fetchSignature(BigInt(request.round))
      if (!signature) continue

      const reward = Amount.fromRaw(BigInt(request.reward), decimals).toFixed(6)
      try {
        await publicClient.simulateContract({
          address: env.hub,
          abi: hubAbi,
          functionName: 'fulfill',
          args: [id, signature],
          account: account?.address ?? '0x0000000000000000000000000000000000000001',
        })
        if (dryRun || !walletClient) {
          console.log(`[dry-run] request ${id} round ${request.round} would pay ${reward} USDC`)
          known.delete(id)
          continue
        }
        inflight.add(id)
        const gas = await publicClient.estimateContractGas({
          address: env.hub,
          abi: hubAbi,
          functionName: 'fulfill',
          args: [id, signature],
          account,
        })
        const hash = await walletClient.writeContract({
          address: env.hub,
          abi: hubAbi,
          functionName: 'fulfill',
          args: [id, signature],
          gas: (gas * 13n) / 10n,
        })
        const receipt = await publicClient.waitForTransactionReceipt({ hash })
        console.log(`fulfilled request ${id} (round ${request.round}, reward ${reward} USDC): ${hash} ${receipt.status}`)
        known.delete(id)
      } catch (error) {
        const message = error instanceof Error ? error.message.split('\n')[0] : 'unknown error'
        console.warn(`request ${id} not fulfilled: ${message}`)
      } finally {
        inflight.delete(id)
      }
    }
  }

  do {
    try {
      await tick()
    } catch (error) {
      console.warn(`pass failed: ${error instanceof Error ? error.message.split('\n')[0] : 'unknown error'}`)
    }
    if (once) break
    await new Promise((resolve) => setTimeout(resolve, POLL_MS))
  } while (running)
}

void main().catch((error) => {
  console.error(error instanceof Error ? error.message : error)
  process.exit(1)
})
