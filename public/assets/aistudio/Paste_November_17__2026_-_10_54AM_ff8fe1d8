/**
 * Orion health monitor (read-only). Checks the hub for stuck requests, reward funding and
 * drand availability, prints a short report and exits non-zero when something needs attention.
 *
 *   bun run monitor              one report
 *   bun run monitor -- --watch   repeat every 30 seconds
 *
 * Environment: VITE_RANDOMNESS_HUB_ADDRESS (required), RPC_URL_Arc_Testnet (optional),
 * MONITOR_LOOKBACK (optional, recent request ids to inspect, default 200).
 */
import { createPublicClient, http, parseAbi, type Address } from 'viem'
import { arcTestnet } from 'viem/chains'
import { requireChain } from '../src/onchain-facts'
import { Amount, gasTokenDecimalsFor } from '../src/onchain-money'

const CHAIN_ID = arcTestnet.id
const HUB = process.env.VITE_RANDOMNESS_HUB_ADDRESS as Address | undefined
if (!HUB) throw new Error('VITE_RANDOMNESS_HUB_ADDRESS is not set')
const LOOKBACK = BigInt(process.env.MONITOR_LOOKBACK ?? '200')
const WARN_AFTER_SECONDS = 60
const CRITICAL_AFTER_SECONDS = 600
const watch = process.argv.includes('--watch')

const hubAbi = parseAbi([
  'struct Request { address consumer; uint64 round; uint32 callbackGas; uint128 reward; uint8 status; }',
  'function nextRequestId() view returns (uint256)',
  'function getRequest(uint256 id) view returns (Request)',
  'function roundTime(uint64 round) view returns (uint256)',
])
const STATUS_PENDING = 1
const STATUS_CALLBACK_FAILED = 3

function rpcUrl(): string {
  if (process.env.RPC_URL_Arc_Testnet) return process.env.RPC_URL_Arc_Testnet
  const chains = (process.env.RPC_PROXY_CHAINS || '').split(',')
  if (process.env.RPC_PROXY_BASE_URL && chains.includes('Arc_Testnet')) {
    return `${process.env.RPC_PROXY_BASE_URL}/api/rpc/Arc_Testnet?_rpc_token=${process.env.RPC_PROXY_TOKEN}`
  }
  return requireChain(CHAIN_ID).rpcUrls[0]
}

const client = createPublicClient({ chain: arcTestnet, transport: http(rpcUrl()) })
const usd = (raw: bigint) => Amount.fromRaw(raw, gasTokenDecimalsFor(CHAIN_ID)).toFixed(6)

async function drandHead(): Promise<number | null> {
  try {
    const res = await fetch('https://api.drand.sh/v2/beacons/evmnet/rounds/latest', { signal: AbortSignal.timeout(8000) })
    if (!res.ok) return null
    const body = (await res.json()) as { round?: number }
    return body.round ?? null
  } catch {
    return null
  }
}

async function report(): Promise<number> {
  const alerts: string[] = []
  const now = Math.floor(Date.now() / 1000)
  const next = await client.readContract({ address: HUB!, abi: hubAbi, functionName: 'nextRequestId' })
  const from = next > LOOKBACK ? next - LOOKBACK : 1n

  let pending = 0
  let failed = 0
  let pendingRewards = 0n
  let oldest = 0
  for (let id = from; id < next; id++) {
    const req = await client.readContract({ address: HUB!, abi: hubAbi, functionName: 'getRequest', args: [id] })
    if (req.status === STATUS_CALLBACK_FAILED) failed++
    if (req.status !== STATUS_PENDING) continue
    pending++
    pendingRewards += BigInt(req.reward)
    const when = Number(await client.readContract({ address: HUB!, abi: hubAbi, functionName: 'roundTime', args: [req.round] }))
    oldest = Math.max(oldest, now - when)
  }

  const balance = await client.getBalance({ address: HUB! })
  const head = await drandHead()

  if (balance < pendingRewards) alerts.push('CRITICAL hub balance is below pending rewards (accounting problem)')
  if (oldest > CRITICAL_AFTER_SECONDS) alerts.push(`CRITICAL a request has been waiting ${oldest}s past its round`)
  else if (oldest > WARN_AFTER_SECONDS) alerts.push(`WARNING a request has been waiting ${oldest}s past its round (is a relayer running?)`)
  if (failed > 0) alerts.push(`WARNING ${failed} request(s) in callback-failed state (anyone can retry)`)
  if (head === null) alerts.push('WARNING drand API unreachable')

  console.log(`[${new Date().toISOString()}] hub ${HUB}`)
  console.log(`  requests inspected: ${next - from} (ids ${from}..${next - 1n})`)
  console.log(`  pending: ${pending}, oldest wait past round: ${oldest}s, callback-failed: ${failed}`)
  console.log(`  hub balance: ${usd(balance)} USDC, pending rewards: ${usd(pendingRewards)} USDC`)
  console.log(`  drand head round: ${head ?? 'unreachable'}`)
  if (alerts.length === 0) console.log('  status: OK')
  for (const alert of alerts) console.log(`  ${alert}`)
  return alerts.some((a) => a.startsWith('CRITICAL')) ? 2 : alerts.length > 0 ? 1 : 0
}

async function main() {
  do {
    let code = 1
    try {
      code = await report()
    } catch (error) {
      console.log(`CRITICAL monitor failed: ${error instanceof Error ? error.message.split('\n')[0] : String(error)}`)
      code = 2
    }
    if (!watch) process.exit(code)
    await new Promise((resolve) => setTimeout(resolve, 30_000))
  } while (true)
}

void main()
