// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import {Test, console2} from "forge-std/Test.sol";
import {RandomnessHubTestBase, RandomnessHub, IRandomnessHub, V, MockConsumer, MockRelayer} from "./RandomnessHub.Base.t.sol";

/// @dev Drives random request/fulfill/cancel/claim/retry sequences with real drand vectors.
contract HubHandler is Test {
    RandomnessHub public hub;
    MockConsumer[] public consumers;
    MockRelayer[] public relayers;
    address public eoaRelayer;
    uint256[] public ids;
    mapping(uint256 => uint256) public vecOf;
    uint256 public totalDealt;
    uint256 public fulfilled;
    uint256 public cancelled;
    uint256 public claimed;
    uint256 public failedCallbacks;

    constructor(RandomnessHub hub_) {
        hub = hub_;
        eoaRelayer = makeAddr("eoaRelayer");
        for (uint256 i; i < 3; i++) {
            consumers.push(new MockConsumer(address(hub_)));
            relayers.push(new MockRelayer(i == 0)); // relayer 0 accepts ETH, others reject
        }
    }

    function _roundTime(uint256 vec) internal view returns (uint256) {
        return hub.genesisTime() + uint256(V.round(vec)) * hub.period();
    }

    function _pickId(uint256 seed) internal view returns (bool ok, uint256 id) {
        if (ids.length == 0) return (false, 0);
        return (true, ids[seed % ids.length]);
    }

    function request(uint256 cSeed, uint256 vec, uint256 rewardSeed, uint256 gasSeed) external {
        MockConsumer c = consumers[cSeed % consumers.length];
        vec = bound(vec, 0, V.COUNT - 1);
        uint256 reward = bound(rewardSeed, 1e16, 1e19);
        uint32 g = uint32(bound(gasSeed, 0, 200_000));
        vm.warp(_roundTime(vec) - 3 * hub.period());
        // The handler funds the request; msg.value is forwarded by the consumer.
        vm.deal(address(this), address(this).balance + reward);
        totalDealt += reward;
        try c.request{value: reward}(g) returns (uint256 id) {
            ids.push(id);
            vecOf[id] = vec;
        } catch {}
    }

    function fulfill(uint256 idSeed, uint256 who) external {
        (bool ok, uint256 id) = _pickId(idSeed);
        if (!ok) return;
        uint256[2] memory sig = V.signature(vecOf[id]);
        uint256 k = who % 4;
        if (k == 3) {
            vm.prank(eoaRelayer);
            try hub.fulfill(id, sig) { fulfilled++; } catch {}
        } else {
            try relayers[k].fulfill(hub, id, sig) { fulfilled++; } catch {}
        }
    }

    function submitBeacon(uint256 vec) external {
        vec = bound(vec, 0, V.COUNT - 1);
        try hub.submitBeacon(V.round(vec), V.signature(vec)) {} catch {}
    }

    function retry(uint256 idSeed) external {
        (bool ok, uint256 id) = _pickId(idSeed);
        if (!ok) return;
        try hub.retryCallback(id) {} catch {}
    }

    function cancel(uint256 idSeed) external {
        (bool ok, uint256 id) = _pickId(idSeed);
        if (!ok) return;
        vm.warp(_roundTime(vecOf[id]) + hub.EXPIRY() + 1);
        address cons = hub.getRequest(id).consumer;
        try MockConsumer(payable(cons)).cancelReq(id) { cancelled++; } catch {}
    }

    function claim(uint256 who) external {
        uint256 k = who % 6;
        if (k < 3) {
            try consumers[k].claimCredit() { claimed++; } catch {}
        } else {
            try relayers[k - 3].claim(hub) { claimed++; } catch {}
        }
    }

    function setConsumerBroken(uint256 idx, bool broken) external {
        consumers[idx % consumers.length].setMode(broken ? MockConsumer.Mode.Revert : MockConsumer.Mode.Good);
    }

    function setConsumerRejectsEth(uint256 idx, bool r) external {
        consumers[idx % consumers.length].setRejectEth(r);
    }

    function setRelayerAccepts(uint256 idx, bool a) external {
        relayers[idx % relayers.length].setAccept(a);
    }

    // ------------------------------------------------------------ views for invariants
    function idCount() external view returns (uint256) { return ids.length; }

    function sumPending() external view returns (uint256 s) {
        uint256 n = hub.nextRequestId();
        for (uint256 id = 1; id < n; id++) {
            IRandomnessHub.Request memory r = hub.getRequest(id);
            if (r.status == IRandomnessHub.Status.Pending) s += r.reward;
        }
    }

    function sumCredits() external view returns (uint256 s) {
        for (uint256 i; i < 3; i++) {
            s += hub.credits(address(consumers[i])) + hub.credits(address(relayers[i]));
        }
        s += hub.credits(eoaRelayer);
    }

    function sumActorBalances() external view returns (uint256 s) {
        for (uint256 i; i < 3; i++) s += address(consumers[i]).balance + address(relayers[i]).balance;
        s += eoaRelayer.balance + address(this).balance;
    }
}

contract RandomnessHubInvariantTest is RandomnessHubTestBase {
    HubHandler internal handler;

    function setUp() public override {
        super.setUp();
        handler = new HubHandler(hub);
        targetContract(address(handler));
        bytes4[] memory sels = new bytes4[](9);
        sels[0] = HubHandler.request.selector;
        sels[1] = HubHandler.fulfill.selector;
        sels[2] = HubHandler.submitBeacon.selector;
        sels[3] = HubHandler.retry.selector;
        sels[4] = HubHandler.cancel.selector;
        sels[5] = HubHandler.claim.selector;
        sels[6] = HubHandler.setConsumerBroken.selector;
        sels[7] = HubHandler.setConsumerRejectsEth.selector;
        sels[8] = HubHandler.setRelayerAccepts.selector;
        targetSelector(FuzzSelector({addr: address(handler), selectors: sels}));
    }

    /// Sanity: the handler's actions actually succeed (so the invariants are not vacuous).
    function test_HandlerActionsAreEffective() public {
        handler.request(0, 3, 1e16, 100_000);
        handler.request(1, 3, 2e16, 100_000);
        handler.request(2, 4, 3e16, 100_000);
        assertEq(handler.idCount(), 3);
        handler.fulfill(0, 0); // relayer 0 accepts ETH
        handler.fulfill(1, 1); // relayer 1 rejects -> credited
        assertEq(handler.fulfilled(), 2);
        assertEq(uint8(hub.getRequest(1).status), uint8(IRandomnessHub.Status.Fulfilled));
        assertGt(handler.sumCredits(), 0);
        handler.claim(4); // relayer 1 still rejecting -> fails
        handler.setRelayerAccepts(1, true);
        handler.claim(4);
        assertEq(handler.claimed(), 1);
        handler.cancel(2);
        assertEq(handler.cancelled(), 1);
        assertEq(handler.sumPending(), 0);
        assertEq(address(hub).balance, handler.sumCredits());
        assertEq(address(hub).balance + handler.sumActorBalances(), handler.totalDealt());
    }

    /// Solvency: the hub always holds at least every pending reward plus every credit.
    function invariant_BalanceCoversPendingRewardsAndCredits() public view {
        assertGe(address(hub).balance, handler.sumPending() + handler.sumCredits());
    }

    /// Tight accounting: nothing is stranded or created (no forced ETH in this model).
    function invariant_BalanceEqualsPendingPlusCredits() public view {
        assertEq(address(hub).balance, handler.sumPending() + handler.sumCredits());
    }

    /// Conservation of value across hub and all participants.
    function invariant_ValueConserved() public view {
        assertEq(address(hub).balance + handler.sumActorBalances(), handler.totalDealt());
    }

    /// Randomness is available exactly when the beacon is stored for a live request.
    function invariant_StoredBeaconsMatchSignatureHash() public view {
        uint256 n = handler.idCount();
        for (uint256 i; i < n; i++) {
            uint256 id = handler.ids(i);
            uint256 vec = handler.vecOf(id);
            bytes32 b = hub.beacon(V.round(vec));
            if (b != bytes32(0)) assertEq(b, keccak256(abi.encode(V.signature(vec))));
        }
    }
}
