// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import {RandomnessConsumer} from "../RandomnessConsumer.sol";
import {IRandomnessHub} from "../IRandomnessHub.sol";

/// @dev Configurable consumer used to exercise good and hostile callback behaviour.
contract MockConsumer is RandomnessConsumer {
    enum Mode { Good, Revert, Burn, ReturnBomb, RevertBomb, Reenter }

    Mode public mode;
    bool public rejectEth;
    uint256 public callbacks;
    uint256 public lastGasLeft;
    bool public reentryAttempted;
    uint256 public reentrySuccesses;
    mapping(uint256 => bytes32) public got;

    error Boom();

    constructor(address hub_) RandomnessConsumer(hub_) {}

    receive() external payable {
        if (rejectEth) revert Boom();
    }

    function setMode(Mode m) external { mode = m; }
    function setRejectEth(bool r) external { rejectEth = r; }

    function request(uint32 callbackGas) external payable returns (uint256) {
        return _requestRandomness(callbackGas, msg.value);
    }

    function cancelReq(uint256 id) external { hub.cancel(id); }
    function claimCredit() external { hub.claim(); }
    function retry(uint256 id) external { hub.retryCallback(id); }

    function _onRandomness(uint256 id, bytes32 randomness) internal override {
        lastGasLeft = gasleft();
        Mode m = mode;
        if (m == Mode.Revert) revert Boom();
        if (m == Mode.Burn) {
            uint256 i;
            while (true) { unchecked { ++i; } }
        }
        if (m == Mode.ReturnBomb) {
            assembly { return(0, 100000) }
        }
        if (m == Mode.RevertBomb) {
            assembly { revert(0, 100000) }
        }
        got[id] = randomness;
        callbacks++;
        if (m == Mode.Reenter) _reenter(id);
    }

    function _reenter(uint256 id) internal {
        reentryAttempted = true;
        uint256[2] memory sig = [uint256(1), uint256(2)];
        IRandomnessHub h = hub;
        try h.fulfill(id, sig) { reentrySuccesses++; } catch {}
        try h.retryCallback(id) { reentrySuccesses++; } catch {}
        try h.claim() { reentrySuccesses++; } catch {}
        try h.cancel(id) { reentrySuccesses++; } catch {}
        try h.submitBeacon(1, sig) { reentrySuccesses++; } catch {}
        try h.requestRandomness{value: 1e16}(0) returns (uint256) { reentrySuccesses++; } catch {}
    }
}

/// @dev Relayer contract whose native-USDC receive can be switched off, made gas-hungry,
/// or made to reenter the hub.
contract MockRelayer {
    bool public accept;
    bool public burn;
    address public reenterHub;
    uint256 public reenterId;
    bool public reentered;

    constructor(bool accept_) { accept = accept_; }

    receive() external payable {
        if (burn) {
            uint256 i;
            while (true) { unchecked { ++i; } }
        }
        if (reenterHub != address(0)) {
            IRandomnessHub h = IRandomnessHub(reenterHub);
            uint256[2] memory sig = [uint256(1), uint256(2)];
            try h.claim() { reentered = true; } catch {}
            try h.fulfill(reenterId, sig) { reentered = true; } catch {}
            try h.retryCallback(reenterId) { reentered = true; } catch {}
        }
        require(accept, "no");
    }

    function setAccept(bool a) external { accept = a; }
    function setBurn(bool b) external { burn = b; }
    function setReenter(address hub_, uint256 id) external { reenterHub = hub_; reenterId = id; }

    function fulfill(IRandomnessHub hub_, uint256 id, uint256[2] calldata sig) external {
        hub_.fulfill(id, sig);
    }

    function claim(IRandomnessHub hub_) external { hub_.claim(); }
}
