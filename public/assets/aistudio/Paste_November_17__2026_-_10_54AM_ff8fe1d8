// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import {RandomnessHubTestBase, RandomnessHub, IRandomnessHub, V, MockConsumer, MockRelayer} from "./RandomnessHub.Base.t.sol";

contract RandomnessHubHostileTest is RandomnessHubTestBase {
    // ---------------------------------------------------------------- (6) hostile consumers

    function test_RevertingCallback_FailedRewardPaidRetryWorks() public {
        _warpToRequest(0);
        MockConsumer c = _newConsumer();
        c.setMode(MockConsumer.Mode.Revert);
        uint256 id = _req(c, CB_GAS, REWARD);

        vm.expectEmit(true, false, false, false, address(hub));
        emit RandomnessHub.CallbackFailed(id);
        _fulfill(relayer, id, 0);

        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.CallbackFailed));
        assertEq(relayer.balance, REWARD, "reward still paid");
        assertEq(address(hub).balance, 0);
        assertEq(c.callbacks(), 0);
        // randomness is still readable
        bytes32 rnd = hub.randomnessOf(id);
        assertTrue(rnd != bytes32(0));

        // Retry while consumer still broken: stays CallbackFailed, no extra payment.
        vm.prank(alice);
        hub.retryCallback(id);
        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.CallbackFailed));
        assertEq(alice.balance, 0);

        // Fix the consumer; retry succeeds, retry caller gets no reward.
        c.setMode(MockConsumer.Mode.Good);
        vm.expectEmit(true, true, false, false, address(hub));
        emit RandomnessHub.Fulfilled(id, alice);
        vm.prank(alice);
        hub.retryCallback(id);
        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.Fulfilled));
        assertEq(c.got(id), rnd);
        assertEq(alice.balance, 0);
        assertEq(relayer.balance, REWARD);

        // Cannot retry again, cannot fulfill again.
        vm.expectRevert(RandomnessHub.InvalidStatus.selector);
        hub.retryCallback(id);
        vm.expectRevert(RandomnessHub.InvalidStatus.selector);
        hub.fulfill(id, _invalidSig());
    }

    function test_ZeroCallbackGas_CallbackFails_ButRewardPaid() public {
        _warpToRequest(1);
        MockConsumer c = _newConsumer();
        uint256 id = _req(c, 0, REWARD);
        _fulfill(relayer, id, 1);
        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.CallbackFailed));
        assertEq(relayer.balance, REWARD);
    }

    function test_CallbackReceivesAtMostItsGasCap() public {
        _warpToRequest(2);
        MockConsumer c = _newConsumer();
        uint256 id = _req(c, CB_GAS, REWARD);
        _fulfill(relayer, id, 2);
        assertEq(c.callbacks(), 1);
        assertLe(c.lastGasLeft(), CB_GAS);
    }

    function test_GasBurningCallback_CannotExceedCap() public {
        _warpToRequest(3);
        // Pre-create the relayer account so the first payout doesn't pay the 25k new-account cost.
        vm.deal(relayer, 1);
        // Baseline: same flow with a no-code consumer (no callback execution).
        vm.deal(alice, 1 ether);
        vm.prank(alice);
        uint256 baseId = hub.requestRandomness{value: REWARD}(CB_GAS);
        MockConsumer burner = _newConsumer();
        burner.setMode(MockConsumer.Mode.Burn);
        uint256 burnId = _req(burner, CB_GAS, REWARD);
        hub.submitBeacon(V.round(3), V.signature(3));

        uint256 g = gasleft();
        vm.prank(relayer);
        hub.fulfill(baseId, _invalidSig());
        uint256 base = g - gasleft();

        g = gasleft();
        vm.prank(relayer);
        hub.fulfill(burnId, _invalidSig());
        uint256 burnt = g - gasleft();

        assertEq(uint8(_status(burnId)), uint8(IRandomnessHub.Status.CallbackFailed));
        assertEq(relayer.balance, 2 * REWARD + 1);
        // Extra gas attributable to the hostile callback is bounded by cap + small call overhead.
        assertLe(burnt, base + CB_GAS + 15_000, "burner exceeded cap");
        assertGe(burnt, base + CB_GAS - 25_000, "burner should have burnt ~cap");
    }

    function test_GasBurningCallback_MaxCap_FulfillStillSucceeds() public {
        _warpToRequest(4);
        MockConsumer burner = _newConsumer();
        burner.setMode(MockConsumer.Mode.Burn);
        uint256 id = _req(burner, uint32(hub.MAX_CALLBACK_GAS()), REWARD);
        vm.prank(relayer);
        hub.fulfill{gas: 2_000_000}(id, V.signature(4));
        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.CallbackFailed));
        assertEq(relayer.balance, REWARD);
    }

    function test_ReentrantConsumer_CannotBreakAccounting() public {
        _warpToRequest(5);
        MockConsumer c = _newConsumer();
        c.setMode(MockConsumer.Mode.Reenter);
        vm.deal(address(c), 10 ether); // so a reentrant requestRandomness would have funds
        uint256 id = c.request{value: REWARD}(uint32(hub.MAX_CALLBACK_GAS()));
        uint256 nextBefore = hub.nextRequestId();
        uint256 consumerBalBefore = address(c).balance;

        vm.prank(relayer);
        hub.fulfill{gas: 3_000_000}(id, V.signature(5));

        assertTrue(c.reentryAttempted(), "callback ran");
        assertEq(c.reentrySuccesses(), 0, "no reentrant hub call may succeed");
        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.Fulfilled));
        assertEq(hub.nextRequestId(), nextBefore);
        assertEq(relayer.balance, REWARD);
        assertEq(address(hub).balance, 0);
        assertEq(address(c).balance, consumerBalBefore);
        assertEq(hub.credits(address(c)), 0);
        assertEq(c.got(id), hub.randomnessOf(id));
    }

    function test_ReentrantConsumer_OnRetryPath() public {
        _warpToRequest(6);
        MockConsumer c = _newConsumer();
        c.setMode(MockConsumer.Mode.Revert);
        uint256 id = _req(c, uint32(hub.MAX_CALLBACK_GAS()), REWARD);
        _fulfill(relayer, id, 6);
        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.CallbackFailed));
        c.setMode(MockConsumer.Mode.Reenter);
        vm.deal(address(c), 1 ether);
        hub.retryCallback{gas: 3_000_000}(id);
        assertEq(c.reentrySuccesses(), 0);
        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.Fulfilled));
        assertEq(address(hub).balance, 0);
        assertEq(relayer.balance, REWARD);
    }

    function test_ReturnDataBomb_DoesNotRevertFulfill() public {
        _warpToRequest(7);
        MockConsumer c = _newConsumer();
        c.setMode(MockConsumer.Mode.ReturnBomb);
        uint256 id = _req(c, 300_000, REWARD);
        uint256 g = gasleft();
        _fulfill(relayer, id, 7);
        uint256 used = g - gasleft();
        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.Fulfilled));
        assertEq(relayer.balance, REWARD);
        // returndata is never copied -> hub cost stays bounded (BLS + callback cap).
        assertLt(used, 1_200_000);
    }

    function test_RevertDataBomb_DoesNotRevertFulfill() public {
        _warpToRequest(8);
        MockConsumer c = _newConsumer();
        c.setMode(MockConsumer.Mode.RevertBomb);
        uint256 id = _req(c, 300_000, REWARD);
        _fulfill(relayer, id, 8);
        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.CallbackFailed));
        assertEq(relayer.balance, REWARD);
    }

    function test_NoCodeConsumer_TreatedAsSuccess() public {
        _warpToRequest(9);
        vm.deal(alice, 1 ether);
        vm.prank(alice);
        uint256 id = hub.requestRandomness{value: REWARD}(CB_GAS);
        vm.expectEmit(true, true, false, false, address(hub));
        emit RandomnessHub.Fulfilled(id, relayer);
        _fulfill(relayer, id, 9);
        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.Fulfilled));
        assertEq(relayer.balance, REWARD);
    }

    function test_WrongHubCannotCallOnRandomness() public {
        MockConsumer c = _newConsumer();
        vm.expectRevert();
        c.onRandomness(1, bytes32(uint256(1)));
    }

    // ---------------------------------------------------------------- (7) payouts

    function test_RelayerRejectingEth_GetsCreditAndCanClaimLater() public {
        _warpToRequest(10);
        MockRelayer rel = new MockRelayer(false);
        MockConsumer c = _newConsumer();
        uint256 id = _req(c, CB_GAS, REWARD);

        vm.expectEmit(true, false, false, true, address(hub));
        emit RandomnessHub.PayoutCredited(address(rel), REWARD);
        rel.fulfill(hub, id, V.signature(10));

        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.Fulfilled));
        assertEq(hub.credits(address(rel)), REWARD);
        assertEq(address(hub).balance, REWARD);
        assertEq(address(rel).balance, 0);
        assertEq(c.callbacks(), 1, "delivery unaffected by payout failure");

        // Still rejecting -> claim reverts and credit is preserved.
        vm.expectRevert(RandomnessHub.TransferFailed.selector);
        rel.claim(hub);
        assertEq(hub.credits(address(rel)), REWARD);
        assertEq(address(hub).balance, REWARD);

        rel.setAccept(true);
        vm.expectEmit(true, false, false, true, address(hub));
        emit RandomnessHub.Claimed(address(rel), REWARD);
        rel.claim(hub);
        assertEq(address(rel).balance, REWARD);
        assertEq(hub.credits(address(rel)), 0);
        assertEq(address(hub).balance, 0);

        vm.expectRevert(RandomnessHub.NoCredit.selector);
        rel.claim(hub);
    }

    function test_GasGriefingRelayer_CreditedAndFulfillCompletes() public {
        _warpToRequest(11);
        MockRelayer rel = new MockRelayer(true);
        rel.setBurn(true);
        MockConsumer c = _newConsumer();
        uint256 id = _req(c, CB_GAS, REWARD);
        uint256 g = gasleft();
        rel.fulfill(hub, id, V.signature(11));
        uint256 used = g - gasleft();
        assertEq(hub.credits(address(rel)), REWARD);
        assertEq(c.callbacks(), 1);
        assertLt(used, 1_000_000, "payout gas must be bounded");
        rel.setBurn(false);
        rel.claim(hub);
        assertEq(address(rel).balance, REWARD);
    }

    function test_ReentrantRelayer_ReceiveCannotReenter() public {
        _warpToRequest(12);
        MockRelayer rel = new MockRelayer(true);
        MockConsumer c = _newConsumer();
        uint256 id1 = _req(c, CB_GAS, REWARD);
        uint256 id2 = _req(c, CB_GAS, REWARD);
        rel.setReenter(address(hub), id2);
        rel.fulfill(hub, id1, V.signature(12));
        // Reentrant attempts all failed, so the payout "reverts" (accept true but...) -> check outcomes.
        assertFalse(rel.reentered(), "reentrancy must not succeed");
        assertEq(uint8(_status(id2)), uint8(IRandomnessHub.Status.Pending));
        // Whatever route the payout took (direct or credit), total value is conserved.
        assertEq(address(rel).balance + hub.credits(address(rel)), REWARD);
        assertEq(address(hub).balance, REWARD + hub.credits(address(rel)));
    }

    function test_Claim_NothingReverts() public {
        vm.prank(alice);
        vm.expectRevert(RandomnessHub.NoCredit.selector);
        hub.claim();
    }

    function test_CreditsAreAccumulatedAcrossPayouts() public {
        _warpToRequest(13);
        MockRelayer rel = new MockRelayer(false);
        MockConsumer c = _newConsumer();
        uint256 id1 = _req(c, CB_GAS, REWARD);
        uint256 id2 = _req(c, CB_GAS, 3 * REWARD);
        rel.fulfill(hub, id1, V.signature(13));
