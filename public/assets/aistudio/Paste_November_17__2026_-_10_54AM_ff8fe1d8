async function fetchSignature(round: bigint): Promise<[bigint, bigint] | null> {
  for (const base of DRAND) {
    try {
      const res = await fetch(`${base}/${round}`, { signal: AbortSignal.timeout(8000) })
      if (!res.ok) continue
      const body = (await res.json()) as { signature?: string }
      if (body.signature && /^[0-9a-fA-F]{128}$/.test(body.signature)) {
        return [BigInt(`0x${body.signature.slice(0, 64)}`), BigInt(`0x${body.signature.slice(64)}`)]
      }
    } catch {
      // next source
    }
  }
  return null
}
async function waitForSignature(round: bigint, seconds = 120): Promise<[bigint, bigint]> {
  const end = Date.now() + seconds * 1000
  while (Date.now() < end) {
    const sig = await fetchSignature(round)
    if (sig) return sig
    await new Promise((r) => setTimeout(r, 2000))
  }
  throw new Error(`drand round ${round} not published within ${seconds}s`)
}

