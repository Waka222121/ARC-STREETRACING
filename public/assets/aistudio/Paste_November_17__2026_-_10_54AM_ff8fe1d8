pragma solidity ^0.8.20;

import {console2} from "forge-std/Test.sol";
import {RandomnessHubTestBase, RandomnessHub, IRandomnessHub, V, MockConsumer} from "./RandomnessHub.Base.t.sol";

contract RandomnessHubRequestTest is RandomnessHubTestBase {
    // ---------------------------------------------------------------- (4) requestRandomness

    function test_Request_RewardBelowMinReverts() public {
        uint256 minReward = hub.MIN_REWARD();
        assertEq(minReward, 1e16);
        vm.deal(alice, 10 ether);
        vm.startPrank(alice);
        vm.expectRevert(RandomnessHub.RewardTooSmall.selector);
        hub.requestRandomness{value: 0}(CB_GAS);
        vm.expectRevert(RandomnessHub.RewardTooSmall.selector);
        hub.requestRandomness{value: minReward - 1}(CB_GAS);
        // exactly MIN_REWARD works
        uint256 id = hub.requestRandomness{value: minReward}(CB_GAS);
        vm.stopPrank();
        assertEq(hub.getRequest(id).reward, minReward);
    }

    function test_Request_RewardAboveUint128Reverts() public {
        uint256 big = uint256(type(uint128).max) + 1;
        vm.deal(alice, big);
        vm.prank(alice);
        vm.expectRevert(RandomnessHub.RewardTooLarge.selector);
        hub.requestRandomness{value: big}(CB_GAS);
        // uint128 max itself is accepted
        vm.prank(alice);
        uint256 id = hub.requestRandomness{value: type(uint128).max}(CB_GAS);
        assertEq(uint256(hub.getRequest(id).reward), uint256(type(uint128).max));
    }

    function test_Request_CallbackGasAboveMaxReverts() public {
        uint32 maxGas = uint32(hub.MAX_CALLBACK_GAS());
        assertEq(maxGas, 500_000);
        vm.deal(alice, 1 ether);
        vm.startPrank(alice);
        vm.expectRevert(RandomnessHub.CallbackGasTooHigh.selector);
        hub.requestRandomness{value: REWARD}(maxGas + 1);
        vm.expectRevert(RandomnessHub.CallbackGasTooHigh.selector);
        hub.requestRandomness{value: REWARD}(type(uint32).max);
        uint256 id = hub.requestRandomness{value: REWARD}(maxGas);
        vm.stopPrank();
        assertEq(uint256(hub.getRequest(id).callbackGas), maxGas);
    }

    function test_Request_RoundOverflowReverts() public {
        vm.warp(V.GENESIS_TIME + (uint256(type(uint64).max) + 2) * V.PERIOD);
        vm.deal(alice, 1 ether);
        vm.prank(alice);
        vm.expectRevert(RandomnessHub.RoundOverflow.selector);
        hub.requestRandomness{value: REWARD}(CB_GAS);
    }

    function test_Request_EmitsRequestedAndStoresFields() public {
        _warpToRequest(2);
        MockConsumer c = _newConsumer();
        vm.deal(address(c), REWARD);
        vm.expectEmit(true, true, false, true, address(hub));
        emit RandomnessHub.Requested(1, address(c), V.round(2), uint128(REWARD));
        uint256 id = c.request{value: REWARD}(CB_GAS);
        assertEq(id, 1);
        IRandomnessHub.Request memory r = hub.getRequest(id);
        assertEq(r.consumer, address(c));
        assertEq(uint256(r.round), uint256(V.round(2)));
        assertEq(uint256(r.callbackGas), uint256(CB_GAS));
        assertEq(uint256(r.reward), REWARD);
        assertEq(uint8(r.status), uint8(IRandomnessHub.Status.Pending));
        assertEq(address(hub).balance, REWARD);
    }

    function test_Request_IdsIncrement() public {
        MockConsumer c = _newConsumer();
        MockConsumer d = _newConsumer();
        assertEq(hub.nextRequestId(), 1);
        assertEq(_req(c, CB_GAS, REWARD), 1);
        assertEq(_req(d, CB_GAS, REWARD), 2);
        assertEq(_req(c, CB_GAS, REWARD), 3);
        assertEq(hub.nextRequestId(), 4);
        assertEq(hub.getRequest(2).consumer, address(d));
        assertEq(address(hub).balance, 3 * REWARD);
    }

    function test_Views_UnknownRequest() public {
        IRandomnessHub.Request memory r = hub.getRequest(999);
        assertEq(r.consumer, address(0));
        assertEq(uint8(r.status), uint8(IRandomnessHub.Status.None));
        vm.expectRevert(RandomnessHub.BeaconUnavailable.selector);
        hub.randomnessOf(999);
    }

    function test_RandomnessOf_UnavailableUntilBeaconStored() public {
        _warpToRequest(0);
        MockConsumer c = _newConsumer();
        uint256 id = _req(c, CB_GAS, REWARD);
        vm.expectRevert(RandomnessHub.BeaconUnavailable.selector);
        hub.randomnessOf(id);
        hub.submitBeacon(V.round(0), V.signature(0));
        assertEq(hub.randomnessOf(id), keccak256(abi.encode(hub.beacon(V.round(0)), address(hub), block.chainid, id)));
    }

    // ---------------------------------------------------------------- (5) fulfill happy path

    function test_Fulfill_HappyPath() public {
        _warpToRequest(4);
        MockConsumer c = _newConsumer();
        uint256 id = _req(c, CB_GAS, REWARD);

        vm.expectEmit(true, true, false, false, address(hub));
        emit RandomnessHub.Fulfilled(id, relayer);
        _fulfill(relayer, id, 4);

        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.Fulfilled));
        assertEq(relayer.balance, REWARD);
        assertEq(address(hub).balance, 0);
        assertEq(hub.credits(relayer), 0);
        bytes32 expected = keccak256(abi.encode(hub.beacon(V.round(4)), address(hub), block.chainid, id));
        assertEq(c.got(id), expected);
        assertEq(hub.randomnessOf(id), expected);
        assertEq(c.callbacks(), 1);

        // Paid exactly once: re-fulfilling is rejected and the relayer balance is unchanged.
        vm.prank(relayer);
        vm.expectRevert(RandomnessHub.InvalidStatus.selector);
        hub.fulfill(id, V.signature(4));
        assertEq(relayer.balance, REWARD);
    }

    function test_Fulfill_UnknownIdReverts() public {
        vm.expectRevert(RandomnessHub.InvalidStatus.selector);
        hub.fulfill(42, V.signature(0));
    }

    function test_Fulfill_TwoRequestsSameRound() public {
        _warpToRequest(5);
        MockConsumer c = _newConsumer();
        MockConsumer d = _newConsumer();
        uint256 id1 = _req(c, CB_GAS, REWARD);
        uint256 id2 = _req(d, CB_GAS, 2 * REWARD);
        assertEq(uint256(hub.getRequest(id1).round), uint256(hub.getRequest(id2).round));

        _fulfill(relayer, id1, 5);
        assertEq(relayer.balance, REWARD);

        // Second request on same round needs no valid signature.
        vm.prank(bob);
        hub.fulfill(id2, _invalidSig());
        assertEq(bob.balance, 2 * REWARD);
        assertEq(uint8(_status(id2)), uint8(IRandomnessHub.Status.Fulfilled));

        assertTrue(c.got(id1) != bytes32(0));
        assertTrue(d.got(id2) != bytes32(0));
        assertTrue(c.got(id1) != d.got(id2));
        assertEq(address(hub).balance, 0);
    }

    function test_Fulfill_DifferentConsumersSameRoundDifferentRandomness() public {
        _warpToRequest(6);
        uint256 n = 5;
        bytes32[] memory seen = new bytes32[](n);
        uint256[] memory ids = new uint256[](n);
        for (uint256 i; i < n; i++) ids[i] = _req(_newConsumer(), CB_GAS, REWARD);
        hub.submitBeacon(V.round(6), V.signature(6));
        for (uint256 i; i < n; i++) {
            seen[i] = hub.randomnessOf(ids[i]);
            for (uint256 j; j < i; j++) assertTrue(seen[i] != seen[j]);
        }
    }

    function test_RetryCallback_InvalidStatusForPendingAndFulfilled() public {
        _warpToRequest(0);
        MockConsumer c = _newConsumer();
        uint256 id = _req(c, CB_GAS, REWARD);
        vm.expectRevert(RandomnessHub.InvalidStatus.selector);
        hub.retryCallback(id);
        _fulfill(relayer, id, 0);
        vm.expectRevert(RandomnessHub.InvalidStatus.selector);
        hub.retryCallback(id);
    }

    // ---------------------------------------------------------------- (9) insufficient gas

    function test_Fulfill_InsufficientGas_StoredBeacon_NoStateChange() public {
        _warpToRequest(7);
        MockConsumer c = _newConsumer();
        uint32 cap = uint32(hub.MAX_CALLBACK_GAS());
        uint256 id1 = _req(c, cap, REWARD);
        uint256 id2 = _req(c, cap, REWARD);
        hub.submitBeacon(V.round(7), V.signature(7));

        // needs ~ cap*64/63 + 30k = ~537.7k at delivery point; give far less.
        vm.prank(relayer);
        (bool ok, bytes memory ret) = address(hub).call{gas: 300_000}(
            abi.encodeCall(IRandomnessHub.fulfill, (id1, _invalidSig()))
        );
        assertFalse(ok);
        assertEq(bytes4(ret), RandomnessHub.InsufficientGas.selector);
        assertEq(uint8(_status(id1)), uint8(IRandomnessHub.Status.Pending));
        assertEq(relayer.balance, 0);
        assertEq(hub.credits(relayer), 0);
        assertEq(address(hub).balance, 2 * REWARD);
        assertEq(c.callbacks(), 0);

        // With enough gas the same request succeeds.
        vm.prank(relayer);
        hub.fulfill{gas: 1_500_000}(id1, _invalidSig());
        assertEq(uint8(_status(id1)), uint8(IRandomnessHub.Status.Fulfilled));
        assertEq(uint8(_status(id2)), uint8(IRandomnessHub.Status.Pending));
        assertEq(relayer.balance, REWARD);
    }

    function test_Fulfill_InsufficientGas_FirstFulfillDoesNotStoreBeacon() public {
        _warpToRequest(8);
        MockConsumer c = _newConsumer();
        uint32 cap = uint32(hub.MAX_CALLBACK_GAS());
        uint256 id = _req(c, cap, REWARD);

        // Enough for BLS verify but not for the callback reserve.
        vm.prank(relayer);
        (bool ok, bytes memory ret) = address(hub).call{gas: 480_000}(
            abi.encodeCall(IRandomnessHub.fulfill, (id, V.signature(8)))
        );
        assertFalse(ok);
        // Either InsufficientGas (BLS fit in budget) or out-of-gas style empty revert; both must not change state.
        if (ret.length >= 4) assertEq(bytes4(ret), RandomnessHub.InsufficientGas.selector);
        assertEq(hub.beacon(V.round(8)), bytes32(0), "beacon must not persist");
        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.Pending));
        assertEq(relayer.balance, 0);
        assertEq(address(hub).balance, REWARD);
        assertEq(c.callbacks(), 0);
    }

    // ---------------------------------------------------------------- (11) gas report

    function test_GasReport_FirstAndSecondFulfill() public {
        _warpToRequest(10);
        MockConsumer c = _newConsumer();
        uint256 id1 = _req(c, CB_GAS, REWARD);
        uint256 id2 = _req(c, CB_GAS, REWARD);
        uint256 id3 = _req(c, CB_GAS, REWARD);

        uint256 g = gasleft();
        vm.prank(relayer);
        hub.fulfill(id1, V.signature(10));
        uint256 first = g - gasleft();

        g = gasleft();
        vm.prank(relayer);
        hub.fulfill(id2, V.signature(10));
        uint256 second = g - gasleft();

        console2.log("GAS fulfill #1 on round (BLS verify + store + pay + callback):", first);
        console2.log("GAS fulfill #2 on same round (no BLS):", second);
        console2.log("GAS BLS verify + store overhead (first - second):", first - second);

        _warpToRequest(11);
        uint256 id4 = _req(_newConsumer(), CB_GAS, REWARD);
        g = gasleft();
        hub.submitBeacon(V.round(11), V.signature(11));
        console2.log("GAS submitBeacon (BLS verify + store):", g - gasleft());
        g = gasleft();
        vm.prank(relayer);
        hub.fulfill(id4, _invalidSig());
        console2.log("GAS fulfill after submitBeacon:", g - gasleft());

        assertGt(first, second);
        assertEq(uint8(_status(id3)), uint8(IRandomnessHub.Status.Pending));
    }
}
