// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import {RandomnessHubTestBase, RandomnessHub, IRandomnessHub, V, MockConsumer} from "./RandomnessHub.Base.t.sol";

contract RandomnessHubCancelTest is RandomnessHubTestBase {
    MockConsumer internal c;
    uint256 internal id;

    function setUp() public override {
        super.setUp();
        _warpToRequest(0);
        c = _newConsumer();
        id = _req(c, CB_GAS, REWARD);
    }

    function test_Cancel_HappyPathAfterExpiry() public {
        vm.warp(_rt(0) + hub.EXPIRY() + 1);
        vm.expectEmit(true, false, false, false, address(hub));
        emit RandomnessHub.Cancelled(id);
        c.cancelReq(id);
        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.Cancelled));
        assertEq(address(c).balance, REWARD, "refunded");
        assertEq(address(hub).balance, 0);
    }

    function test_Cancel_NotConsumerReverts() public {
        vm.warp(_rt(0) + hub.EXPIRY() + 1);
        vm.prank(alice);
        vm.expectRevert(RandomnessHub.NotConsumer.selector);
        hub.cancel(id);
        vm.prank(alice);
        vm.expectRevert(RandomnessHub.NotConsumer.selector);
        hub.cancel(12345); // unknown id has no consumer
        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.Pending));
    }

    function test_Cancel_NotExpiredReverts_BoundaryExact() public {
        vm.warp(_rt(0) - 1);
        vm.expectRevert(RandomnessHub.NotExpired.selector);
        c.cancelReq(id);
        vm.warp(_rt(0) + hub.EXPIRY()); // exactly at expiry: still not expired
        vm.expectRevert(RandomnessHub.NotExpired.selector);
        c.cancelReq(id);
        vm.warp(_rt(0) + hub.EXPIRY() + 1);
        c.cancelReq(id);
        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.Cancelled));
    }

    function test_Cancel_RevertsIfBeaconStored() public {
        hub.submitBeacon(V.round(0), V.signature(0));
        vm.warp(_rt(0) + hub.EXPIRY() + 1);
        vm.expectRevert(RandomnessHub.BeaconAlreadyStored.selector);
        c.cancelReq(id);
        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.Pending));
        assertEq(address(hub).balance, REWARD);
        // Still fulfillable after expiry
        _fulfill(relayer, id, 0);
        assertEq(relayer.balance, REWARD);
    }

    function test_Cancel_DoubleCancelReverts_RefundedOnce() public {
        vm.warp(_rt(0) + hub.EXPIRY() + 1);
        c.cancelReq(id);
        vm.expectRevert(RandomnessHub.InvalidStatus.selector);
        c.cancelReq(id);
        assertEq(address(c).balance, REWARD);
        assertEq(address(hub).balance, 0);
    }

    function test_Cancel_AfterFulfillReverts() public {
        _fulfill(relayer, id, 0);
        vm.warp(_rt(0) + hub.EXPIRY() + 1);
        vm.expectRevert(RandomnessHub.InvalidStatus.selector);
        c.cancelReq(id);
        assertEq(address(c).balance, 0);
    }

    function test_Fulfill_AfterCancelReverts() public {
        vm.warp(_rt(0) + hub.EXPIRY() + 1);
        c.cancelReq(id);
        vm.prank(relayer);
        vm.expectRevert(RandomnessHub.InvalidStatus.selector);
        hub.fulfill(id, V.signature(0));
        assertEq(relayer.balance, 0);
    }

    function test_Cancel_AfterCallbackFailedReverts() public {
        c.setMode(MockConsumer.Mode.Revert);
        _fulfill(relayer, id, 0);
        assertEq(uint8(_status(id)), uint8(IRandomnessHub.Status.CallbackFailed));
        vm.warp(_rt(0) + hub.EXPIRY() + 1);
        vm.expectRevert(RandomnessHub.InvalidStatus.selector);
        c.cancelReq(id);
    }

    function test_Cancel_RefundToRejectingConsumerIsCreditedAndClaimable() public {
        c.setRejectEth(true);
        vm.warp(_rt(0) + hub.EXPIRY() + 1);
        vm.expectEmit(true, false, false, true, address(hub));
        emit RandomnessHub.PayoutCredited(address(c), REWARD);
        c.cancelReq(id);
        assertEq(hub.credits(address(c)), REWARD);
        assertEq(address(hub).balance, REWARD);
        c.setRejectEth(false);
        c.claimCredit();
        assertEq(address(c).balance, REWARD);
        assertEq(address(hub).balance, 0);
        vm.expectRevert(RandomnessHub.NoCredit.selector);
        c.claimCredit();
    }

    function test_Cancel_EoaConsumerRefund() public {
        vm.deal(alice, 1 ether);
        vm.prank(alice);
        uint256 id2 = hub.requestRandomness{value: REWARD}(CB_GAS);
        uint256 before = alice.balance;
        vm.warp(_rt(0) + hub.EXPIRY() + 1);
        vm.prank(alice);
        hub.cancel(id2);
        assertEq(alice.balance, before + REWARD);
    }
}
