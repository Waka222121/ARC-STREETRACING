}
async function fulfill(id: bigint, sig: [bigint, bigint]) {
  const gas = await pub.estimateContractGas({ address: HUB, abi: hubAbi, functionName: 'fulfill', args: [id, sig], account })
  return send(wallet.writeContract({ address: HUB, abi: hubAbi, functionName: 'fulfill', args: [id, sig], gas: (gas * 13n) / 10n }))
}

async function main() {
  console.log(`Hub ${HUB}\nDemo ${DEMO}\nTester ${account.address}\nRPC chain ${await pub.getChainId()}\n`)
  const startBalance = await pub.getBalance({ address: account.address })
  console.log(`Tester balance: ${usd(startBalance)} USDC\n`)

  await check('chain id is Arc Testnet', async () => {
    const id = await pub.getChainId()
    if (id !== CHAIN_ID) throw new Error(`got ${id}`)
    return String(id)
  })
  await check('hub constants match drand evmnet', async () => {
    const key = await pub.readContract({ address: HUB, abi: hubAbi, functionName: 'publicKey' })
    if (key.some((w, i) => w !== EXPECTED_KEY[i])) throw new Error('public key mismatch')
    const g = await pub.readContract({ address: HUB, abi: hubAbi, functionName: 'genesisTime' })
    const p = await pub.readContract({ address: HUB, abi: hubAbi, functionName: 'period' })
    if (g !== 1727521075n || p !== 3n) throw new Error(`genesis ${g} period ${p}`)
    return 'key, genesis, period ok'
  })

  await expectRevert('request below minimum reward is rejected', 'RewardTooSmall', () =>
    pub.simulateContract({ address: HUB, abi: hubAbi, functionName: 'requestRandomness', args: [100000], value: 1n, account }),
  )
  await expectRevert('callback gas above cap is rejected', 'CallbackGasTooHigh', () =>
    pub.simulateContract({ address: HUB, abi: hubAbi, functionName: 'requestRandomness', args: [600000], value: REWARD, account }),
  )

  let first: Awaited<ReturnType<typeof roll>> | undefined
  await check('roll() creates a request tied to a future round', async () => {
    first = await roll()
    const when = await pub.readContract({ address: HUB, abi: hubAbi, functionName: 'roundTime', args: [first.round] })
    const margin = Number(when) - Number(first.timestamp)
    if (margin < 9) throw new Error(`round only ${margin}s after request block`)
    const req = await pub.readContract({ address: HUB, abi: hubAbi, functionName: 'getRequest', args: [first.id] })
    if (req.status !== 1 || req.consumer.toLowerCase() !== DEMO.toLowerCase() || req.reward !== REWARD) throw new Error('request fields wrong')
    return `id ${first.id}, round ${first.round}, ${margin}s ahead of the request block`
  })
  if (!first) throw new Error('cannot continue without a request')
  const f = first

  await expectRevert('bad signature is rejected', 'InvalidSignature', () =>
    pub.simulateContract({ address: HUB, abi: hubAbi, functionName: 'fulfill', args: [f.id, [1n, 2n]], account }),
  )
  await expectRevert('signature of a different (older) round is rejected', 'InvalidSignature', async () => {
    const old = await fetchSignature(f.round - 1000n)
    if (!old) throw new Error('could not fetch old round')
    return pub.simulateContract({ address: HUB, abi: hubAbi, functionName: 'fulfill', args: [f.id, old], account })
  })
  await expectRevert('only the consumer can cancel', 'NotConsumer', () =>
    pub.simulateContract({ address: HUB, abi: hubAbi, functionName: 'cancel', args: [f.id], account }),
  )

  const before = await pub.getBalance({ address: account.address })
  let sig: [bigint, bigint] = [0n, 0n]
  await check('real drand signature for the request round is published', async () => {
    sig = await waitForSignature(f.round)
    return `round ${f.round}`
  })
  let firstGas = 0n
  await check('fulfill with the real drand signature succeeds', async () => {
    const receipt = await fulfill(f.id, sig)
    firstGas = receipt.gasUsed
    const stored = await pub.readContract({ address: HUB, abi: hubAbi, functionName: 'beacon', args: [f.round] })
    if (stored === `0x${'00'.repeat(32)}`) throw new Error('beacon not stored')
    return `gas used ${receipt.gasUsed}`
  })
  await check('demo consumer received the value from the callback', async () => {
    const [ready, value] = await pub.readContract({ address: DEMO, abi: demoAbi, functionName: 'resultOf', args: [f.id] })
    const hubValue = await pub.readContract({ address: HUB, abi: hubAbi, functionName: 'randomnessOf', args: [f.id] })
    if (!ready || value !== hubValue) throw new Error('consumer value does not match hub value')
    return value
  })
  await check('relayer reward arrived (balance change net of gas is positive or near zero)', async () => {
    const after = await pub.getBalance({ address: account.address })
    const delta = after - before
    return `net change ${delta >= 0n ? '+' : '-'}${usd(delta >= 0n ? delta : -delta)} USDC (reward ${usd(REWARD)} minus gas)`
  })
  await expectRevert('request cannot be fulfilled twice', 'InvalidStatus', () =>
    pub.simulateContract({ address: HUB, abi: hubAbi, functionName: 'fulfill', args: [f.id, sig], account }),
  )
  await expectRevert('submitting an already stored round is rejected', 'BeaconAlreadyStored', () =>
    pub.simulateContract({ address: HUB, abi: hubAbi, functionName: 'submitBeacon', args: [f.round, sig], account }),
  )
  await expectRevert('retryCallback on a delivered request is rejected', 'InvalidStatus', () =>
    pub.simulateContract({ address: HUB, abi: hubAbi, functionName: 'retryCallback', args: [f.id], account }),
  )
  await expectRevert('claim with no credit is rejected', 'NoCredit', () =>
    pub.simulateContract({ address: HUB, abi: hubAbi, functionName: 'claim', account }),
  )

  await check('two requests in the same round get different values; second needs no signature', async () => {
    const a = await roll()
    const b = await roll()
    const sigA = await waitForSignature(a.round)
    await fulfill(a.id, sigA)
    let note = ''
    let gasB: bigint
    if (b.round === a.round) {
      const receipt = await fulfill(b.id, [0n, 0n])
      gasB = receipt.gasUsed
      note = 'same round, signature skipped'
    } else {
      const receipt = await fulfill(b.id, await waitForSignature(b.round))
      gasB = receipt.gasUsed
      note = `different rounds (${a.round}, ${b.round})`
    }
    const va = await pub.readContract({ address: HUB, abi: hubAbi, functionName: 'randomnessOf', args: [a.id] })
    const vb = await pub.readContract({ address: HUB, abi: hubAbi, functionName: 'randomnessOf', args: [b.id] })
    if (va === vb) throw new Error('values are equal')
    return `${note}; second fulfill gas ${gasB}`
  })

  console.log(`\nFirst fulfill of a round (BLS verification) used ${firstGas} gas on Arc Testnet.`)
  const failed = results.filter((r) => !r.ok)
  console.log(`\n${results.length - failed.length} passed, ${failed.length} failed`)
  const end = await pub.getBalance({ address: account.address })
  console.log(`Tester balance now: ${usd(end)} USDC`)
  process.exit(failed.length ? 1 : 0)
}

void main().catch((error) => {
  console.error(error instanceof Error ? error.message : error)
  process.exit(1)
})
